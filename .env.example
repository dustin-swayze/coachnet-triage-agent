# Copy to .env (gitignored). Never commit real values. Loaded by src/triage/config.py.

# ---- Runtime mode -----------------------------------------------------------
# mock: fake chat model + fake embeddings + fixture-backed tools. No keys needed.
# live: real LLM + real integrations. Requires the credentials below.
TRIAGE_MODE=mock

# ---- LLM (agent-internal model; separate from the Claude Code session model) --
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_MODEL=claude-sonnet-5-5       # try claude-haiku-5-5 once evals exist (Phase 5)
ANTHROPIC_API_KEY=                # required when TRIAGE_MODE=live and LLM_PROVIDER=anthropic
OPENAI_API_KEY=                   # required when TRIAGE_MODE=live and LLM_PROVIDER=openai

# ---- Partner scoping (fail-closed) ------------------------------------------
# Every scoped tool filters on PARTNER_CODE. Empty value => tools refuse to run.
PARTNER_CODE=CNET
PARTNER_NAME="Coach Net"

# ---- Agent limits -----------------------------------------------------------
STEP_CAP=8                        # max tool invocations per run
TOOL_TIMEOUT_SECONDS=15           # per tool call
RUN_BUDGET_SECONDS=60             # total wall-clock per run
TRACE_DIR=traces

# ---- Salesforce (read-only integration user; sandbox first) -----------------
SF_INSTANCE_URL=                  # e.g. https://<your-org>--<sandbox>.sandbox.my.salesforce.com
SF_CLIENT_ID=                     # connected app, read-only perm set
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=                      # TODO(dustin): prefer JWT bearer flow; confirm org policy
SF_API_VERSION=v62.0
# Field API names. TODO(dustin): confirm against the API contract / XMLs in the work repo.
SF_CASE_PARTNER_FIELD=Partner_Code__c
SF_CASE_EXTERNAL_ID_FIELD=HubSpot_Ticket_Id__c
SF_CASE_SYNC_STATUS_FIELD=Sync_Status__c
SF_CASE_LAST_SYNC_FIELD=Last_Sync_At__c
SF_CASE_CORRELATION_FIELD=Mule_Correlation_Id__c
SF_CASE_REDISPATCH_FIELD=Redispatch__c

# ---- Anypoint (connected app, view-only scopes) ------------------------------
ANYPOINT_CLIENT_ID=
ANYPOINT_CLIENT_SECRET=
ANYPOINT_ORG_ID=
ANYPOINT_ENV_ID=
ANYPOINT_PRIVATE_SPACE_ID=        # CloudHub 2.0 Private Space
MULE_APP_NAME=coachnet-saas-api   # TODO(dustin): exact deployment name in Runtime Manager
ANYPOINT_BASE_URL=https://anypoint.mulesoft.com
# TODO(dustin): confirm the CloudHub 2.0 logs endpoint and its filter capabilities (Phase 4)

# ---- Runbook / retrieval ------------------------------------------------------
RUNBOOK_DIR=docs/runbook
INDEX_DIR=data/index              # derived, gitignored; rebuild: uv run python -m triage index
EMBEDDINGS_PROVIDER=hashing       # hashing | openai | voyage. TODO(dustin): live choice

# ---- Mock-mode knobs (ignored when TRIAGE_MODE=live) --------------------------
MOCK_APP_STATE=healthy            # healthy | down | deploying | restart_loop | status_error

# ---- LangSmith (optional hosted tracing; OFF by default; see ADR 0006) ----------
# JSONL traces in TRACE_DIR are always written and are the system of record.
# LangSmith uploads REDACTED prompts/outputs to LangChain's cloud. Enable only where
# that is approved (TrxNow: confirm with team lead before using real case data).
# When false, tracing is forced off even if LANGSMITH_TRACING is set in the shell.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=                # required when LANGSMITH_ENABLED=true
LANGSMITH_PROJECT=partner-triage
LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # EU: https://eu.api.smith.langchain.com

# ---- Slack bot (Phase 6; see docs/slack-setup.md and ADR 0007) -------------------
# Socket Mode: the bot connects out to Slack; no public URL needed.
# Use a PERSONAL demo workspace for mock mode. TrxNow's Slack needs admin approval
# and its own app and tokens (never reuse the demo tokens).
SLACK_BOT_TOKEN=                  # xoxb-...  OAuth & Permissions > Bot User OAuth Token
SLACK_APP_TOKEN=                  # xapp-...  Basic Information > App-Level Tokens (connections:write)
# Fail-closed: answers are posted only in an allowlisted channel, or in a DM with an
# allowlisted user. Both empty => the bot refuses everyone. Comma-separated ids.
SLACK_ALLOWED_CHANNEL_IDS=        # e.g. C0123ABCD (a PRIVATE channel; answers contain case details)
SLACK_ALLOWED_USER_IDS=           # e.g. U0123ABCD (may DM the bot and use :app in mock mode)
SLACK_ALERT_CHANNEL_ID=           # health alerts go here; empty = no poller
HEALTH_POLL_SECONDS=300           # use 30 for a demo
SLACK_MAX_RUNS_PER_USER_PER_HOUR=20
